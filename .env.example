# ---- Gemini -----------------------------------------------------------------
# Two ways to reach Gemini, and the default here is the one with no setup cost.
#
# false  the developer API: an AI Studio key and nothing else. No project, no
#        billing link, no quota grant. Get a key at https://aistudio.google.com
# true   Vertex AI: needs GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION below,
#        a project with Vertex enabled, and a billing account attached.
#
# If Gemini calls fail with UNAUTHENTICATED ("API keys are not supported by this
# API"), this is set true while only a key is present -- the request went to
# Vertex, which will not take a key.
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=need-your-own-pal
GEMINI_MODEL=gemini-2.5-flash

# Only read when GOOGLE_GENAI_USE_VERTEXAI=true, and by the omnivoice engine.
#GOOGLE_CLOUD_PROJECT=your-project-id
#GOOGLE_CLOUD_LOCATION=us-central1

# ---- Speech engine ----------------------------------------------------------
# qwen3-tts  Qwen3-TTS-12Hz-1.7B-Base on vLLM-Omni. Apache-2.0 weights, clones
#            from a 3 s reference, streams, and returns word timings.
# omnivoice  k2-fsa/OmniVoice on a Vertex AI endpoint. Three ceilings that are
#            architectural rather than fixable -- no emphasis markup, no word
#            timings, no intra-utterance streaming -- and CC-BY-NC weights,
#            which makes any deployment of it non-commercial.
#
# Whichever you pick, decide it on evidence rather than preference:
#   uv run python scripts/bench_tts.py --both
TTS_ENGINE=qwen3-tts

# Where qwen3-tts is served. A local vLLM-Omni, or a deployment:
#   modal deploy qwen/modal_app.py   -- needs a Modal account
#   ./deploy_qwen_cloudrun.sh        -- needs a project, billing and L4 quota
QWEN_TTS_URL=http://localhost:8091

# Credentials for a private endpoint. Leave unset for a local vLLM-Omni.
# The Modal deployment keeps proxy auth on, so without these every request
# comes back 401 -- which from the outside is indistinguishable from a cold
# start, and the face will wait in its waking pose forever. Get a pair from
# `modal token new`.
#QWEN_TTS_KEY=wk-...
#QWEN_TTS_SECRET=ws-...
# Or one header's worth instead -- also how you reach a Cloud Run service
# behind IAM, where the value is an identity token.
#QWEN_TTS_BEARER=wk-....ws-...

# ---- OmniVoice --------------------------------------------------------------
# Only needed when TTS_ENGINE=omnivoice. Set after running deploy_vertex.sh/ps1;
# the engine also reads GOOGLE_CLOUD_PROJECT above.
#OMNIVOICE_LOCATION=us-central1
#OMNIVOICE_ENDPOINT_ID=your-endpoint-id
# 32 is the library default; 16 is the documented fast setting.
#OMNIVOICE_NUM_STEP=16

# ---- Hugging Face -----------------------------------------------------------
# Optional. Qwen3-TTS, its tokenizer, the forced aligner and k2-fsa/OmniVoice
# are all public and ungated, so images build fine without a token. Set it only
# if anonymous rate limits bite on a shared IP.
#HF_TOKEN=hf_...
