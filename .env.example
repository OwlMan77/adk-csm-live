# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
OMNIVOICE_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Gemini model for transcription and conversation
GEMINI_MODEL=gemini-2.5-flash

# OmniVoice Vertex AI endpoint — set after running deploy_vertex.sh/ps1
OMNIVOICE_ENDPOINT_ID=your-endpoint-id

# Hugging Face token — required to build the OmniVoice Docker image
HF_TOKEN=hf_...
